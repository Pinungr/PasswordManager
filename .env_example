SECUREVAULT_DATABASE_KEY=
SECUREVAULT_AUDIT_KEY=
SECUREVAULT_BACKUP_KEY=
SECUREVAULT_BOOTSTRAP_PASSWORD=

# HTTPS and loopback are the defaults. HTTP requires development mode.
# SECUREVAULT_PROTOCOL=https
# SECUREVAULT_ENVIRONMENT=production
# SECUREVAULT_HOST_MODE=local
# SECUREVAULT_HOSTNAME=localhost
# SECUREVAULT_PUBLISH_IP=127.0.0.1
# SECUREVAULT_PUBLISH_PORT=18443

# Docker and TLS overrides
# SECUREVAULT_IMAGE=pinaki-securevault:1.0.0
# SECUREVAULT_ENV_FILE=.env
# SECUREVAULT_TLS_DIRECTORY=./deploy/tls
# SECUREVAULT_TLS_CERT_FILE=/tls/tls-cert.pem
# SECUREVAULT_TLS_KEY_FILE=/tls/tls-key.pem
# SECUREVAULT_TLS_CA_FILE=/tls/tls-ca.pem
# SECUREVAULT_INTERNAL_HOST=0.0.0.0
# SECUREVAULT_INTERNAL_PORT=8443
# SECUREVAULT_DATA_DIR=/data
# SECUREVAULT_PROJECT=pinaki-securevault

# Optional initial administrator metadata and mounted secret paths
# SECUREVAULT_BOOTSTRAP_USERNAME=admin
# SECUREVAULT_BOOTSTRAP_FULL_NAME=Administrator
# SECUREVAULT_DATABASE_KEY_FILE=
# SECUREVAULT_AUDIT_KEY_FILE=
# SECUREVAULT_BACKUP_KEY_FILE=
# SECUREVAULT_CONFIG_FILE=

# Application defaults
# SECUREVAULT_APP_NAME=Pinaki SecureVault
# SECUREVAULT_MAX_REGISTERED_USERS=1000
# SECUREVAULT_SESSION_TIMEOUT_MINUTES=480
# SECUREVAULT_VAULT_AUTO_LOCK_MINUTES=5
# SECUREVAULT_SECRET_REVEAL_TIMEOUT_SECONDS=30
# SECUREVAULT_CLIPBOARD_CLEAR_SECONDS=30
# SECUREVAULT_ACCOUNT_PASSWORD_MIN_LENGTH=8
# SECUREVAULT_MAX_LOGIN_ATTEMPTS=5
# SECUREVAULT_LOGIN_LOCKOUT_MINUTES=15
# SECUREVAULT_PASSWORD_HISTORY_LIMIT=10
# SECUREVAULT_RECYCLE_BIN_RETENTION_DAYS=30
# SECUREVAULT_BACKUP_RETENTION_DAYS=7
# SECUREVAULT_BACKUP_SCHEDULE=02:00
# SECUREVAULT_MAX_FIELDS_PER_CREDENTIAL=100
# SECUREVAULT_MAX_FIELD_VALUE_BYTES=65536
# SECUREVAULT_TIMEZONE=Asia/Kolkata
# SECUREVAULT_LOG_LEVEL=INFO
# SECUREVAULT_DEFAULT_THEME=light
